SECRET_KEY=django-insecure-whatbytes-healthcare-secret-key-2026-production-ready
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# If DB_NAME is set, Django connects to PostgreSQL.
# For local SQLite development/testing without PostgreSQL service running, leave DB_NAME empty.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
